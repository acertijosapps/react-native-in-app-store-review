{
  "name": "@bgoswaldo/react-native-in-app-store-review",
  "version": "1.0.0",
  "description": "In-app store review prompt for React Native — iOS SKStoreReviewController and Android Play In-App Review, with a store-listing fallback.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.tsx",
  "source": "src/index.tsx",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!android/build",
    "!android/.gradle"
  ],
  "scripts": {
    "prepare": "bob build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "review",
    "rating",
    "app-store",
    "play-store",
    "SKStoreReviewController",
    "in-app-review"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/bgoswaldo-group/rninappstorereview.git"
  },
  "author": "bgoswaldo <bgoswaldo@gmail.com>",
  "license": "MIT",
  "homepage": "https://gitlab.com/bgoswaldo-group/rninappstorereview#readme",
  "bugs": {
    "url": "https://gitlab.com/bgoswaldo-group/rninappstorereview/-/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.86.0",
    "@types/react": "^19.0.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.35.0",
    "typescript": "^5.8.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
