{
  "name": "@acertijosapps/react-native-in-app-store-review",
  "version": "1.1.2",
  "description": "Ask users to rate and review your React Native app in-app — native iOS (SKStoreReviewController) and Android (Play In-App Review) prompts, with an App Store / Play Store fallback.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.tsx",
  "source": "src/index.tsx",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!android/build",
    "!android/.gradle"
  ],
  "scripts": {
    "prepare": "bob build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react-native",
    "react-native-in-app-store-review",
    "react-native-in-app-review",
    "react-native-store-review",
    "ios",
    "android",
    "expo",
    "review",
    "reviews",
    "rating",
    "ratings",
    "rate",
    "rate-app",
    "rate-us",
    "app-review",
    "app-rating",
    "in-app-review",
    "in-app-rating",
    "store-review",
    "app-store",
    "appstore",
    "play-store",
    "google-play",
    "storekit",
    "SKStoreReviewController",
    "play-core"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/acertijoslibs/rninappstorereview.git"
  },
  "author": "AcertijosApps <acertijos.contacto@gmail.com>",
  "license": "MIT",
  "homepage": "https://acertijosapps.com/librerias/react-native-in-app-store-review",
  "bugs": {
    "url": "https://gitlab.com/acertijoslibs/rninappstorereview/-/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.74"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.86.0",
    "@types/react": "^19.0.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.35.0",
    "typescript": "^5.8.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
